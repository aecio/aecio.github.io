<div class="publications">

<h1>Publications</h1>
<div id="search-box">
  <input type="text" autofocus id="search-input" placeholder="Search publications..." style="width: 100%; padding: 7px;">
</div>

<div id="search-area" style="display: none;">
  <span id="search-result-message" class="mt-2" style="font-size: 0.8em; color: #888;"></span>
  <!-- <h3>Search Results</h3> -->
  <ul id="search-results">
    <!-- Filled with search results -->
  </ul>
</div>

<div id="all-publications" style="display: block;" class="mt-3">
  <!-- <h3>Peer Reviewed</h3> -->
{{#page.extra.publications}}
  <h4 class='publication_year'>{{ year }}</h4>
  <ul>
  {{#articles}}
    <li style="padding: 10px 0px">
      <b>{{{title}}}</b><br/>
      {{{authors}}}<br/>
      <em class="badge badge-secondary">{{{series}}}</em> {{{venue}}}<br/>
      <small>{{{comments}}}</small>
      <div class="mt-2" style="display:flex">
        <div class="btn-group_" role="group" aria-label="Paper download options">
          {{#arxiv_url}}
          <a class="btn btn-outline-primary" href="{{ arxiv_url }}" target="_blank">
            <i class="fa fa-file"></i>
            Arxiv
          </a>
          {{/arxiv_url}}
          {{#pdf_url}}
          <a class="btn btn-outline-primary" href="{{ pdf_url }}" target="_blank">
            <i class="fa fa-file-pdf"></i>
            PDF
          </a>
          {{/pdf_url}}
          {{#acmdl_url}}
          <a class="btn btn-outline-primary" href="{{ acmdl_url }}" target="_blank" referrerpolicy="no-referrer-when-downgrade">
            <i class="fa fa-book-atlas"></i>
            ACM DL
          </a>
          {{/acmdl_url}}
          {{#ieee_url}}
          <a class="btn btn-outline-primary" href="{{ ieee_url }}" target="_blank">
            <i class="fa fa-book-atlas"></i>
            IEEE Xplore
          </a>
          {{/ieee_url}}
          {{#siam_url}}
          <a class="btn btn-outline-primary" href="{{ siam_url }}" target="_blank">
            <i class="fa fa-book-atlas"></i>
            SIAM
          </a>
          {{/siam_url}}
          {{#springer_url}}
          <a class="btn btn-outline-primary" href="{{ springer_url }}" target="_blank">
            <i class="fa fa-book-atlas"></i>
            Springer
          </a>
          {{/springer_url}}
          {{#code_url}}
          <a class="btn btn-outline-primary" href="{{ code_url }}" target="_blank">
            <i class="fa fa-code"></i>
            Source Code
          </a>
          {{/code_url}}
          {{#slides_url}}
          <a class="btn btn-outline-primary" href="{{ slides_url }}" target="_blank">
            <i class="fa fa-file-powerpoint"></i>
            Slides
          </a>
          {{/slides_url}}
        </div>
      </div>
    </li>
  {{/articles}}
  </ul>
{{/page.extra.publications}}

